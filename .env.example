# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant Cloud or local Qdrant
QDRANT_URL=
# Local Docker example: QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=neotokyo_places

# Neo4j Aura, Desktop, or local Docker
NEO4J_URI=
# Local Docker example: NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=
# NEO4J_USERNAME also works if your provider uses that variable name.
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
